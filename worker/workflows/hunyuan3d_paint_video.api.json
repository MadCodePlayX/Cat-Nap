{
  "_comment_1": "Hunyuan3D-2.1 SHAPE + PBR PAINT + Wan 2.2 I2V composite workflow.",
  "_comment_2": "Requires these custom nodes (install via ComfyUI Manager):",
  "_comment_3": "  - ComfyUI-Hunyuan3DWrapper (Kijai)        -> Hy3DRenderMultiView, Hy3DSampleMultiView, Hy3DBakeFromMultiview, Hy3DExportMesh",
  "_comment_4": "  - ComfyUI-WanVideoWrapper (Kijai)        -> WanVideoSampler, WanVideoTextEncode, WanVideoDecode, WanVideoModelLoader",
  "_comment_5": "  - ComfyUI-VideoHelperSuite              -> VHS_VideoCombine",
  "_comment_6": "Then in ComfyUI: Save (API Format) -> drop the JSON in here -> update node IDs in worker.py PATCH_NODES dict.",

  "2": {
    "class_type": "LoadImage",
    "inputs": {"image": "input.png"}
  },

  "20": {
    "class_type": "Hy3DModelLoader",
    "inputs": {"model": "hunyuan3d-dit-v2-1.safetensors"}
  },
  "21": {
    "class_type": "Hy3DGenerateMesh",
    "inputs": {
      "pipeline": ["20", 0],
      "image": ["2", 0],
      "steps": 30,
      "guidance_scale": 5.0,
      "seed": 107,
      "octree_resolution": 384
    }
  },

  "30": {
    "class_type": "Hy3DPaintModelLoader",
    "inputs": {"model": "hunyuan3d-paintpbr-v2-1"}
  },
  "31": {
    "class_type": "Hy3DRenderMultiView",
    "inputs": {
      "trimesh": ["21", 0],
      "render_size": 512,
      "texture_size": 2048
    }
  },
  "32": {
    "class_type": "Hy3DSampleMultiView",
    "inputs": {
      "pipeline": ["30", 0],
      "ref_image": ["2", 0],
      "normal_maps": ["31", 0],
      "position_maps": ["31", 1],
      "steps": 20,
      "seed": 42
    }
  },
  "33": {
    "class_type": "Hy3DBakeFromMultiview",
    "inputs": {
      "trimesh": ["21", 0],
      "albedo_views": ["32", 0],
      "mr_views": ["32", 1],
      "render_data": ["31", 2]
    }
  },
  "34": {
    "class_type": "Hy3DExportMesh",
    "inputs": {
      "trimesh": ["33", 0],
      "filename_prefix": "catnap/mesh_textured",
      "file_format": "glb"
    }
  },

  "40": {
    "class_type": "WanVideoModelLoader",
    "inputs": {
      "model": "Wan2_2-I2V-A14B-fp8_e4m3fn.safetensors",
      "base_precision": "fp8_e4m3fn",
      "quantization": "fp8_e4m3fn",
      "load_device": "main_device"
    }
  },
  "41": {
    "class_type": "WanVideoTextEncode",
    "inputs": {
      "positive_prompt": "Tabby cat slowly walks toward the felt cat house, sniffs it, then settles inside. Soft natural living-room light, shallow depth of field, locked-off camera, photoreal, cinematic.",
      "negative_prompt": "blurry, distorted cat anatomy, extra legs, morphing object, watermark, text, logo",
      "model": ["40", 0]
    }
  },
  "42": {
    "class_type": "WanVideoSampler",
    "inputs": {
      "model": ["40", 0],
      "image_embeds": ["2", 0],
      "text_embeds": ["41", 0],
      "steps": 20,
      "cfg": 5.0,
      "shift": 5.0,
      "seed": 1234,
      "frame_count": 81,
      "width": 720,
      "height": 480
    }
  },
  "43": {
    "class_type": "WanVideoDecode",
    "inputs": {"samples": ["42", 0]}
  },
  "44": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["43", 0],
      "frame_rate": 16,
      "filename_prefix": "catnap/lifestyle",
      "format": "video/h264-mp4",
      "crf": 19
    }
  }
}
